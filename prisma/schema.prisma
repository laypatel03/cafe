// Healthy Hunger – data model (doc/goal → Data model).
// Money is stored in paise (Int) so totals never suffer from floating point.
// Targets PostgreSQL 14+.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STAFF
  OWNER
  /// website only: menu, café details, QR – no orders, money or customers
  DEVELOPER
}

enum OrderType {
  DINE_IN
  PARCEL
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED // served at the table, or picked up for parcel
  PAID
  CANCELLED
}

enum SelectionStatus {
  SELECTING // guest is still picking
  CONFIRMED // guest placed it as an order (kept briefly so the guest's phone can catch up)
}

enum PaymentMethod {
  CASH
  UPI // Google Pay and other UPI apps
  CARD // bills from before 13 Oct 2026, when card wasn't split; counted as credit card
  CREDIT_CARD
  DEBIT_CARD
}

/// What an expense was for (owner-facing names live in src/lib/expenses.ts).
enum ExpenseCategory {
  VEGETABLES_FRUITS
  GROCERY
  DAIRY
  PACKAGING
  GAS
  ELECTRICITY_WATER
  RENT
  SALARIES
  REPAIRS
  OTHER
}

/// How an expense was paid. CASH comes out of the counter drawer.
enum ExpensePayment {
  CASH
  UPI
  CARD
  BANK
}

/// Where a day's opening cash came from.
enum CashOpening {
  ENTERED // counted by staff in the morning
  CARRIED // nobody entered it – taken from the last day's closing
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  visible   Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id           String      @id @default(cuid())
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name         String
  description  String      @default("")
  ingredients  String[]
  pricePaise   Int
  proteinG     Int         @default(0)
  kcal         Int         @default(0)
  photo        String? // path under UPLOAD_DIR, served at /media/…
  isBestseller Boolean     @default(false)
  isVeg        Boolean     @default(true)
  available    Boolean     @default(true) // false = sold out (staff can toggle)
  visible      Boolean     @default(true) // false = hidden from the menu (owner)
  sortOrder    Int         @default(0)
  addOns       AddOn[]
  orderItems   OrderItem[]
  offers       Offer[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([categoryId, sortOrder])
}

model AddOn {
  id         String     @id @default(cuid())
  name       String
  pricePaise Int
  proteinG   Int        @default(0)
  kcal       Int        @default(0)
  available  Boolean    @default(true)
  sortOrder  Int        @default(0)
  menuItems  MenuItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Customer {
  id               String                 @id @default(cuid())
  name             String
  phone            String                 @unique // 10-digit Indian mobile – the customer's ID
  email            String?
  marketingConsent Boolean                @default(false)
  consentAt        DateTime?
  notes            String?
  firstVisitAt     DateTime               @default(now())
  lastVisitAt      DateTime               @default(now())
  orderCount       Int                    @default(0)
  totalSpendPaise  Int                    @default(0)
  orders           Order[]
  mealPasses       MealPass[]
  balanceEntries   CustomerBalanceEntry[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model Order {
  id             String                 @id @default(cuid())
  number         Int                    @unique @default(autoincrement())
  type           OrderType
  status         OrderStatus            @default(NEW)
  customerId     String?
  customer       Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // snapshot of who ordered, kept even if the customer record is deleted on request
  customerName   String
  customerPhone  String?
  pickupAt       DateTime? // parcel: null = ASAP
  note           String?
  subtotalPaise  Int
  taxPaise       Int                    @default(0)
  totalPaise     Int
  cancelReason   String?
  // deleted by the owner from Order history: kept and shown in red, but left out of the money book and reports
  deletedAt      DateTime?
  // set when the cashier generates the bill for this visit
  billId         String?
  bill           Bill?                  @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdById    String? // staff member who confirmed the order with the guest
  createdBy      StaffUser?             @relation("CounterOrders", fields: [createdById], references: [id], onDelete: SetNull)
  items          OrderItem[]
  statusLogs     OrderStatusLog[]
  mealPassUses   MealPassUse[]
  balanceEntries CustomerBalanceEntry[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([customerPhone])
  @@index([billId])
}

/// Dine-in: one bill per guest visit (all their served rounds). Takeaway: one bill per order.
model Bill {
  id                 String                 @id @default(cuid())
  number             Int                    @unique @default(autoincrement())
  type               OrderType
  customerName       String
  customerPhone      String?
  subtotalPaise      Int
  taxBasisPoints     Int                    @default(0)
  taxPaise           Int                    @default(0)
  totalPaise         Int
  /// paid over (+) or under (−) the total, kept on the customer's balance; money taken = total + this
  differencePaise    Int                    @default(0)
  paymentMethod      PaymentMethod?
  paidAt             DateTime?
  // order completed without payment ("pay later"); paidAt is set when the guest pays
  payLaterAt         DateTime?
  createdById        String?
  createdBy          StaffUser?             @relation("BillsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  orders             Order[]
  balanceEntries     CustomerBalanceEntry[]
  // a bill made by mistake is voided, never deleted, so bill numbers stay continuous;
  // its orders are unlinked (to be billed again) and their numbers kept here
  voidedAt           DateTime?
  voidReason         String?
  voidedOrderNumbers Int[]                  @default([])
  voidedById         String?
  voidedBy           StaffUser?             @relation("BillsVoided", fields: [voidedById], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now())

  @@index([createdAt])
  @@index([paidAt])
}

model OrderItem {
  id             String                @id @default(cuid())
  orderId        String
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem?             @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  // copied at order time so old bills never change when the menu does
  itemName       String
  unitPricePaise Int // item + chosen add-ons
  quantity       Int
  addOns         Json                  @default("[]") // [{ id, name, pricePaise }]
  lineTotalPaise Int
  // "Other item" the owner typed in instead of a dish – a negative price is a discount
  custom         Boolean               @default(false)
  // set on the discount line a meal pass adds; undoing the use removes the line
  mealPassUseId  String?               @unique
  mealPassUse    MealPassUse?          @relation(fields: [mealPassUseId], references: [id], onDelete: Cascade)
  // set on the line that settles a customer's balance on this order; undoing removes the line
  balanceEntryId String?               @unique
  balanceEntry   CustomerBalanceEntry? @relation(fields: [balanceEntryId], references: [id], onDelete: Cascade)
}

model OrderStatusLog {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  changedBy   StaffUser?   @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

model StaffUser {
  id             String                 @id @default(cuid())
  name           String
  username       String                 @unique
  phone          String?                @unique
  passwordHash   String
  role           Role                   @default(STAFF)
  active         Boolean                @default(true)
  // bumped on password change / deactivation to invalidate existing sessions
  sessionVersion Int                    @default(1)
  lastLoginAt    DateTime?
  statusChanges  OrderStatusLog[]
  counterOrders  Order[]                @relation("CounterOrders")
  billsCreated   Bill[]                 @relation("BillsCreated")
  billsVoided    Bill[]                 @relation("BillsVoided")
  expenses       Expense[]              @relation("ExpensesAdded")
  cashDaysOpened CashDay[]              @relation("CashDaysOpened")
  cashDaysClosed CashDay[]              @relation("CashDaysClosed")
  extraSales     ExtraSale[]            @relation("ExtraSalesAdded")
  passesSold     MealPass[]             @relation("PassesSold")
  mealPassUses   MealPassUse[]          @relation("MealPassUses")
  balanceEntries CustomerBalanceEntry[] @relation("BalanceEntries")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

/// A lower price on one dish for a run of café days (IST, inclusive). Orders placed on those
/// days are charged the offer price; the regular price shows struck through beside it.
model Offer {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  pricePaise Int
  /// optional short line shown with the offer, e.g. "Monday special"
  title      String   @default("")
  /// yyyy-mm-dd, IST
  startsOn   String
  endsOn     String
  createdAt  DateTime @default(now())

  @@index([endsOn])
}

/// Single row (id = 1) with the café's details and switches.
model CafeSettings {
  id                     Int      @id @default(1)
  name                   String   @default("Healthy Hunger")
  tagline                String   @default("Eat well, live well")
  address                String   @default("")
  mapUrl                 String   @default("")
  phone                  String   @default("")
  whatsapp               String   @default("")
  instagram              String   @default("")
  fssaiLicence           String   @default("") // 14 digits; shown with the FSSAI mark in the site footer
  gaMeasurementId        String   @default("") // Google Analytics 4, "G-XXXXXXX"; empty = no analytics
  // Google Places ID ("ChIJ…") for the reviews section on the home page; the API key is in .env
  googlePlaceId          String   @default("")
  hours                  Json     @default("[]") // [{ days, time }]
  orderingEnabled        Boolean  @default(true)
  // the public Blog pages and links; off = hidden from guests (staff who are logged in can still preview)
  blogEnabled            Boolean  @default(false)
  taxBasisPoints         Int      @default(0) // 500 = 5 %
  todaysPickId           String?
  // what the card machine provider keeps, in basis points (180 = 1.8 %); taken off profit in the money book
  creditCardFeeBps       Int      @default(0)
  debitCardFeeBps        Int      @default(0)
  // owner switches: allow adding/editing orders in Order history, and adding/editing customers
  orderEditsEnabled      Boolean  @default(false)
  mealPassRefundsEnabled Boolean  @default(false)
  customerEditsEnabled   Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

/// Fixed-window rate limiting for login and order forms.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

/// A guest's live pick list (one per device). Staff watch it live; the cashier turns it into an Order.
model Selection {
  id        String          @id // random id kept on the guest's device
  takeaway  Boolean         @default(false)
  code      Int // short random number so staff can tell guests' lists apart
  status    SelectionStatus @default(SELECTING)
  orderId   String? // set once the guest places the order
  // resolved on the server: [{ itemId, name, quantity, addOns: [{ id, name }] }]
  items     Json
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([updatedAt])
}

/// Money the café spent: supplies, bills, salaries … Staff add; the owner edits or deletes.
model Expense {
  id          String          @id @default(cuid())
  paidAt      DateTime        @default(now())
  amountPaise Int
  category    ExpenseCategory
  paidWith    ExpensePayment
  paidTo      String? // vendor or person
  note        String?
  createdById String?
  createdBy   StaffUser?      @relation("ExpensesAdded", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([paidAt])
}

/// The cash drawer for one café day: opening cash in the morning, the count at closing.
/// Totals are copied in when the day is closed, so later edits don't change a closed day.
model CashDay {
  id                String      @id @default(cuid())
  day               String      @unique // yyyy-mm-dd, café time (IST)
  openingPaise      Int
  openingSource     CashOpening
  openedById        String?
  openedBy          StaffUser?  @relation("CashDaysOpened", fields: [openedById], references: [id], onDelete: SetNull)
  closedAt          DateTime?
  cashSalesPaise    Int? // snapshot at closing
  cashExpensesPaise Int? // snapshot at closing
  expectedPaise     Int? // opening + cash sales − cash expenses, at closing
  countedPaise      Int? // what staff counted in the drawer
  closeNote         String?
  closedById        String?
  closedBy          StaffUser?  @relation("CashDaysClosed", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

/// Sales that never went through a bill (e.g. a counter sale written on paper), added in the money book.
model ExtraSale {
  id           String                @id @default(cuid())
  soldAt       DateTime // noon of the day it belongs to (café time), like back-dated expenses
  method       PaymentMethod
  amountPaise  Int
  note         String?
  createdById  String?
  createdBy    StaffUser?            @relation("ExtraSalesAdded", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now())
  passSale     MealPass?             @relation("PassSale")
  passRefund   MealPass?             @relation("PassRefund")
  balanceEntry CustomerBalanceEntry? @relation("BalanceSale")

  @@index([soldAt])
}

/// A kind of meal pass the owner sells, e.g. "Bowl + smoothie": 26 bowls and 26 smoothies in 30 days.
/// A dish counts if it is in a meal type's categories and costs up to its cap; dearer ones pay the difference.
model MealPlan {
  id         String     @id @default(cuid())
  name       String
  pricePaise Int
  /// meal types: [{ name, meals, categoryIds, capPaise }] (see lib/meal-pass.ts MealPart)
  parts      Json       @default("[]")
  days       Int        @default(30)
  active     Boolean    @default(true)
  passes     MealPass[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

/// One customer's pass. The plan's rules are copied in, so editing a plan never changes passes sold.
/// Meals left = plan counts minus uses on orders that aren't cancelled or deleted.
model MealPass {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement())
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // snapshot, kept if the customer record is deleted on request
  customerName  String
  customerPhone String?
  planId        String?
  plan          MealPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName      String
  pricePaise    Int
  /// the plan's meal types when sold
  parts         Json           @default("[]")
  /// yyyy-mm-dd, IST, inclusive; unused meals lapse after endsOn
  startsOn      String
  endsOn        String
  method        PaymentMethod
  /// the money in: an ExtraSale, so it shows in the money book and cash drawer
  saleId        String?        @unique
  sale          ExtraSale?     @relation("PassSale", fields: [saleId], references: [id], onDelete: SetNull)
  soldById      String?
  soldBy        StaffUser?     @relation("PassesSold", fields: [soldById], references: [id], onDelete: SetNull)
  refundedAt    DateTime?
  refundPaise   Int?
  refundMethod  PaymentMethod?
  refundNote    String?
  /// the money back: a minus ExtraSale
  refundSaleId  String?        @unique
  refundSale    ExtraSale?     @relation("PassRefund", fields: [refundSaleId], references: [id], onDelete: SetNull)
  uses          MealPassUse[]
  createdAt     DateTime       @default(now())

  @@index([customerId])
  @@index([endsOn])
}

/// One meal taken from a pass on an order; its discount line is the OrderItem pointing here.
model MealPassUse {
  id           String     @id @default(cuid())
  passId       String
  pass         MealPass   @relation(fields: [passId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// index into the pass's parts; partName kept for history
  part         Int
  partName     String
  menuItemId   String?
  coveredPaise Int
  /// a dish from outside the plan\'s categories, counted as a meal at the counter
  swap         Boolean    @default(false)
  usedById     String?
  usedBy       StaffUser? @relation("MealPassUses", fields: [usedById], references: [id], onDelete: SetNull)
  line         OrderItem?
  createdAt    DateTime   @default(now())

  @@index([passId])
  @@index([orderId])
}

/// Why a customer's balance changed.
enum BalanceKind {
  /// paid more than the bill (or left an advance) – we owe them
  PAID_EXTRA
  /// paid less than the bill – they owe us
  PAID_LESS
  /// paid back money they owed
  PAID_BACK
  /// we gave back money they had paid extra
  RETURNED
  /// used on a later order: a line on that order takes it off (credit) or adds it (owed)
  SETTLED
}

/// Money a customer paid over or under, and how it was settled.
/// Balance = sum of amountPaise (plus = credit, the café owes them; minus = they owe the café),
/// leaving out SETTLED entries on cancelled or deleted orders.
model CustomerBalanceEntry {
  id          String         @id @default(cuid())
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind        BalanceKind
  amountPaise Int
  method      PaymentMethod?
  /// the bill that was paid over or under
  billId      String?
  bill        Bill?          @relation(fields: [billId], references: [id], onDelete: SetNull)
  /// SETTLED: the order it went on (its line is the OrderItem pointing here)
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// the money that changed hands, so the money book and cash drawer match (none for SETTLED)
  saleId      String?        @unique
  sale        ExtraSale?     @relation("BalanceSale", fields: [saleId], references: [id], onDelete: SetNull)
  note        String?
  createdById String?
  createdBy   StaffUser?     @relation("BalanceEntries", fields: [createdById], references: [id], onDelete: SetNull)
  line        OrderItem?
  createdAt   DateTime       @default(now())

  @@index([customerId])
  @@index([orderId])
}
