diff --git a/src/components/admin/pager.tsx b/src/components/admin/pager.tsx
new file mode 100644
index 0000000..779239f
--- /dev/null
+++ b/src/components/admin/pager.tsx
@@ -0,0 +1,117 @@
+import { ChevronLeft, ChevronRight } from "lucide-react";
+import Link from "next/link";
+import { PAGE_SIZES, pageNumbers, rangeLabel } from "@/lib/paging";
+import { cn } from "@/lib/utils";
+
+/**
+ * Page links under an admin list: "11–20 of 134", ‹ 1 … 4 5 6 … 14 ›, and (optionally) how many
+ * to show per page. Plain links, so the browser's back button and shared URLs keep the page.
+ */
+export function Pager({
+  page,
+  pages,
+  total,
+  perPage,
+  noun,
+  href,
+  sizes = false,
+}: {
+  page: number;
+  pages: number;
+  total: number;
+  perPage: number;
+  /** what's being counted, plural: "orders" */
+  noun: string;
+  /** link for a page (and page size, when sizes are offered) */
+  href: (to: { page: number; perPage: number }) => string;
+  /** show the 10 / 25 / 50 per page choice */
+  sizes?: boolean;
+}) {
+  if (total === 0) return null;
+  const link = "inline-flex h-9 min-w-9 items-center justify-center rounded-full px-3 text-sm";
+  return (
+    <nav
+      aria-label={`${noun} pages`}
+      className="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-border bg-card px-3 py-2"
+    >
+      <p className="tabular text-sm text-muted-foreground">
+        {rangeLabel(page, perPage, total)} {noun}
+      </p>
+
+      {pages > 1 && (
+        <ul className="flex flex-wrap items-center gap-1">
+          <li>
+            {page > 1 ? (
+              <Link
+                href={href({ page: page - 1, perPage })}
+                className={cn(link, "hover:bg-muted")}
+                aria-label="Previous page"
+              >
+                <ChevronLeft className="size-4" aria-hidden />
+              </Link>
+            ) : (
+              <span className={cn(link, "text-muted-foreground/40")} aria-hidden>
+                <ChevronLeft className="size-4" />
+              </span>
+            )}
+          </li>
+          {pageNumbers(page, pages).map((n, i) =>
+            n === "…" ? (
+              <li key={`gap-${i}`} className="px-1 text-muted-foreground" aria-hidden>
+                …
+              </li>
+            ) : (
+              <li key={n}>
+                <Link
+                  href={href({ page: n, perPage })}
+                  aria-current={n === page ? "page" : undefined}
+                  className={cn(
+                    link,
+                    "tabular",
+                    n === page ? "bg-primary font-semibold text-primary-foreground" : "hover:bg-muted",
+                  )}
+                >
+                  {n}
+                </Link>
+              </li>
+            ),
+          )}
+          <li>
+            {page < pages ? (
+              <Link
+                href={href({ page: page + 1, perPage })}
+                className={cn(link, "hover:bg-muted")}
+                aria-label="Next page"
+              >
+                <ChevronRight className="size-4" aria-hidden />
+              </Link>
+            ) : (
+              <span className={cn(link, "text-muted-foreground/40")} aria-hidden>
+                <ChevronRight className="size-4" />
+              </span>
+            )}
+          </li>
+        </ul>
+      )}
+
+      {sizes && (
+        <p className="flex items-center gap-1 text-sm text-muted-foreground">
+          Show
+          {PAGE_SIZES.map((n) => (
+            <Link
+              key={n}
+              href={href({ page: 1, perPage: n })}
+              aria-current={n === perPage ? "true" : undefined}
+              className={cn(
+                "rounded-full px-2 py-0.5 tabular",
+                n === perPage ? "bg-secondary font-semibold text-secondary-foreground" : "hover:bg-muted",
+              )}
+            >
+              {n}
+            </Link>
+          ))}
+        </p>
+      )}
+    </nav>
+  );
+}
