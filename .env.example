DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/healthy_hunger?schema=public"
AUTH_SECRET="generate with: openssl rand -base64 32"
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD="choose a strong password"
UPLOAD_DIR="./uploads"
# Public address of the site (share previews, sitemap)
SITE_URL="http://localhost:3000"
# Google Places API (New) key for the home page reviews; restrict it to Places API in Google Cloud.
# The Place ID goes in Admin → Settings. Empty = no reviews section.
GOOGLE_MAPS_API_KEY=""
# Local development only: `pnpm db:seed` adds an owner login admin / admin (ignored in production)
SEED_DEV_ADMIN="false"

# Backups (scripts/backup/backup.sh, nightly 03:00 IST)
BACKUP_DIR="/var/backups/healthy-hunger"
# 0 = keep every copy, never delete
BACKUP_KEEP_DAYS="30"
# restore each backup into a throwaway database to prove it works (needs CREATEDB)
BACKUP_RESTORE_CHECK="true"
# who gets the nightly email – comma-separated
BACKUP_EMAIL_TO="owner@example.com"
# any SMTP account; Gmail: smtps://smtp.gmail.com:465 with an app password (Google account → Security → App passwords)
SMTP_URL="smtps://smtp.gmail.com:465"
SMTP_USER="cafe.account@gmail.com"
SMTP_PASS="app password"
SMTP_FROM="cafe.account@gmail.com"

# WhatsApp Cloud API (Meta) – bills and due reminders. Empty = staff get wa.me links instead.
# WhatsApp Manager → API setup: a permanent System User token and the number's Phone number ID.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v23.0"
# WhatsApp Manager → Account tools → WhatsApp account ID; optional – shows what Meta charged this month
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Template names + language exactly as in WhatsApp Manager (empty = bill_receipt / due_reminder / en).
# Sending uses the name; the IDs are kept for editing templates from the app later.
WHATSAPP_BILL_TEMPLATE=""
WHATSAPP_REMINDER_TEMPLATE=""
# the pay-later thank-you: empty = nothing is sent when a bill goes on pay later
# "payment received" when pay-later bills are paid off – empty = nothing sent
WHATSAPP_PAYMENT_TEMPLATE=""
WHATSAPP_PAYLATER_TEMPLATE=""
# first-visit thank-you with the Google review link (welcome_review) – empty = not sent
WHATSAPP_WELCOME_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE=""
WHATSAPP_BILL_TEMPLATE_ID=""
WHATSAPP_REMINDER_TEMPLATE_ID=""
WHATSAPP_PAYLATER_TEMPLATE_ID=""
WHATSAPP_PAYMENT_TEMPLATE_ID=""
WHATSAPP_WELCOME_TEMPLATE_ID=""
# Webhook (delivery status + STOP replies): https://<site>/api/whatsapp/webhook
# verify token = any long random text you also type in Meta; app secret = App settings → Basic
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# Due reminders: the hourly timer (scripts/whatsapp/) calls the app with this. openssl rand -hex 32
CRON_SECRET=""
# where the timer reaches the app on the server
APP_URL="http://127.0.0.1:3000"
