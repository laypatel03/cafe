DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/healthy_hunger?schema=public"
AUTH_SECRET="generate with: openssl rand -base64 32"
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD="choose a strong password"
UPLOAD_DIR="./uploads"
# Public address of the site (share previews, sitemap)
SITE_URL="http://localhost:3000"
# Google Places API (New) key for the home page reviews; restrict it to Places API in Google Cloud.
# The Place ID goes in Admin → Settings. Empty = no reviews section.
GOOGLE_MAPS_API_KEY=""
# Local development only: `pnpm db:seed` adds an owner login admin / admin (ignored in production)
SEED_DEV_ADMIN="false"

# Backups (scripts/backup/backup.sh, nightly 03:00 IST)
BACKUP_DIR="/var/backups/healthy-hunger"
# 0 = keep every copy, never delete
BACKUP_KEEP_DAYS="30"
# restore each backup into a throwaway database to prove it works (needs CREATEDB)
BACKUP_RESTORE_CHECK="true"
# who gets the nightly email – comma-separated
BACKUP_EMAIL_TO="owner@example.com"
# any SMTP account; Gmail: smtps://smtp.gmail.com:465 with an app password (Google account → Security → App passwords)
SMTP_URL="smtps://smtp.gmail.com:465"
SMTP_USER="cafe.account@gmail.com"
SMTP_PASS="app password"
SMTP_FROM="cafe.account@gmail.com"
