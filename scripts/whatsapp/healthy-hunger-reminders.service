# Copy to /etc/systemd/system/ with the timer – see doc/whatsapp-setup.md.
[Unit]
Description=Healthy Hunger WhatsApp pay-later notes and due reminders (sends only when it's time)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# the app's user and folder on the server
User=cafe
WorkingDirectory=/srv/healthy-hunger
ExecStart=/usr/bin/env bash scripts/whatsapp/run-reminders.sh
