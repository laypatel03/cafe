[Unit]
Description=Check for WhatsApp pay-later notes, due reminders and welcomes every hour

[Timer]
# every hour, on the hour (owner, 5 Nov); the app decides: pay-later notes 30 min after closing, reminders at the day and
# hour set in Settings → WhatsApp – each goes once, so the extra runs send nothing
OnCalendar=*-*-* *:00:00 Asia/Kolkata
Persistent=true

[Install]
WantedBy=timers.target
