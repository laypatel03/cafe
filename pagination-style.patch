diff --git a/src/components/admin/page-size-select.tsx b/src/components/admin/page-size-select.tsx
new file mode 100644
index 0000000..171de7e
--- /dev/null
+++ b/src/components/admin/page-size-select.tsx
@@ -0,0 +1,26 @@
+"use client";
+
+import { ChevronDown } from "lucide-react";
+import { useRouter } from "next/navigation";
+
+/** "10 ▾" – rows per page. Each size has its own link, worked out on the server. */
+export function PageSizeSelect({ value, hrefs }: { value: number; hrefs: Record<number, string> }) {
+  const router = useRouter();
+  return (
+    <label className="relative inline-flex items-center">
+      <span className="sr-only">Rows per page</span>
+      <select
+        value={value}
+        onChange={(e) => router.push(hrefs[Number(e.target.value)])}
+        className="h-11 cursor-pointer appearance-none rounded-[10px] bg-muted pr-10 pl-4 tabular text-base font-semibold text-foreground outline-none focus-visible:ring-3 focus-visible:ring-ring/40"
+      >
+        {Object.keys(hrefs).map((n) => (
+          <option key={n} value={n}>
+            {n}
+          </option>
+        ))}
+      </select>
+      <ChevronDown className="pointer-events-none absolute right-3 size-4" aria-hidden />
+    </label>
+  );
+}
